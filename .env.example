# Copy this file to .env and fill in your own values. NEVER commit .env (it is in .gitignore).

# LLM (Recommend step). Without a key the app runs in offline mode (keyword match + manual review).
OPENAI_API_KEY=your_openai_api_key_here
KLARSCHIFF_MODEL=gpt-4o-mini

# LangSmith tracing and evaluation (free Developer plan: https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=klarschiff
# EU data region (optional): LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Review rules (business decisions)
KLARSCHIFF_CONFIDENCE_THRESHOLD=0.75
KLARSCHIFF_LARGE_SHIPMENT_TONNES=100

# --- v2.2 pilot options ---
# Login: set a long password on any shared server (empty = no login, local demo only)
KLARSCHIFF_APP_PASSWORD=
# Model that reads scanned invoices and photos (default: same as KLARSCHIFF_MODEL)
# KLARSCHIFF_VISION_MODEL=gpt-4o-mini
# European provider instead of OpenAI (OpenAI-compatible API), e.g. Mistral AI:
# KLARSCHIFF_LLM_BASE_URL=https://api.mistral.ai/v1
# KLARSCHIFF_LLM_API_KEY=your_mistral_api_key_here
# KLARSCHIFF_MODEL=mistral-small-latest
# KLARSCHIFF_VISION_MODEL=pixtral-large-latest
