# Copy this file to .env and fill in your own values. Never commit the real .env file.

# LLM provider (used by the n8n POC: GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# --- Planned for Round 2 / pilot (not used by the Round 1 POC) ---

# Vector store for tariff/HS code lookup (RAG)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=hs-code-tariff-index

# Airtable review dashboard
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# n8n instance (if calling it programmatically / webhooks)
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-webhook-id
